		{
			"name": "2. Payment Callback (GET)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}bkash/callback?paymentID={{payment_id}}&status=success",
					"host": [
						"{{base_url}}bkash"
					],
					"path": [
						"callback"
					],
					"query": [
						{
							"key": "paymentID",
							"value": "{{payment_id}}",
							"description": "Payment ID from create payment"
						},
						{
							"key": "status",
							"value": "success",
							"description": "Payment status (success/failure)"
						}
					]
				},
				"description": "**This endpoint is called automatically by bKash after payment completion.**\n\nYou don't need to call this manually. bKash will redirect to this URL after payment.\n\n**What happens:**\n1. User completes payment on bKash\n2. bKash calls this callback URL\n3. API executes payment and verifies\n4. Creates package_history record\n5. Returns success/failure response\n\n**Response:**\n- transactionID: bKash transaction ID\n- paymentID: Payment ID\n- package details\n- package_history_id: Record ID in database"
			},
